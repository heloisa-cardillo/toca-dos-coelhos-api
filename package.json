{
  "name": "toca-dos-coelhos-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST da Toca dos Coelhos, com Express e PostgreSQL.",
  "main": "dist/server.js",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "security": "npm audit --audit-level=high",
    "build": "tsc -p tsconfig.json && node scripts/copiar-front.js",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration --runInBand",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
